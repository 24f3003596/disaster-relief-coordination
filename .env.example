# Flask application environment
APP_ENV=development

# Flask security configuration
SECRET_KEY=replace-with-a-strong-random-secret-key

# Database configuration
# SQLite database is stored inside the Flask instance directory.
DATABASE_URL=sqlite:///disaster_relief.db

# Application settings
SQLALCHEMY_TRACK_MODIFICATIONS=False

# OTP configuration
OTP_TTL_MINUTES=5
OTP_DEMO_MODE=0