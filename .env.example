# Copy this file to .env for local development. Never commit .env.
APP_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
# Flask-SQLAlchemy resolves sqlite:/// relative to the instance directory.
DATABASE_URL=sqlite:///disaster_relief.db
OTP_TTL_MINUTES=5
# Enable only for local demonstrations; keep disabled in production.
OTP_DEMO_MODE=0
